{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {"maxDuration": 300},
    "api/ui.py": {"maxDuration": 60}
  },
  "rewrites": [
    {"source":"/favicon.ico","destination":"/web/favicon.svg"},
    {"source":"/favicon.svg","destination":"/web/favicon.svg"},
    {"source":"/capture","destination":"/web/capture.html"},
    {"source":"/capture/","destination":"/web/capture.html"}
  ],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}

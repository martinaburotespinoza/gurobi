{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {"maxDuration": 300},
    "api/ui.py": {"maxDuration": 60}
  },
  "rewrites": [
    {"source":"/favicon.ico","destination":"/web/favicon.svg"},
    {"source":"/favicon.svg","destination":"/web/favicon.svg"},
    {"source":"/capture","destination":"/web/capture.html"},
    {"source":"/capture/","destination":"/web/capture.html"},
    {"source":"/","destination":"/api/index.py/r2-cockpit"}
  ],
  "headers":[
    {"source":"/api/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}

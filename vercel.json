{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/favicon.ico", "dest": "/web/favicon.svg" },
    { "src": "/favicon.svg", "dest": "/web/favicon.svg" },
    { "src": "/gurobean-logo.svg", "dest": "/web/gurobean-logo.svg" },
    { "src": "/capture", "dest": "/web/capture.html" },
    { "src": "/capture/", "dest": "/web/capture.html" },
    { "src": "/app", "dest": "/api/index.py" },
    { "src": "/app/", "dest": "/api/index.py" },
    { "src": "/", "dest": "/api/index.py" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}